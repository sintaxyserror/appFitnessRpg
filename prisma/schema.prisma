datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())

  character       Character?
  workoutSessions WorkoutSession[]
  routines        Routine[]
}

enum CharacterClass {
  UNDEFINED
  WARRIOR
  EXPLORER
  MONK
  PALADIN
}

model Character {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  characterClass CharacterClass @default(UNDEFINED)

  level       Int @default(1)
  skillPoints Int @default(0)

  pendingClass CharacterClass?
  pendingSince DateTime?

  vitalityDecayAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attributes       Attribute[]
  missions         Mission[]
  achievements     Achievement[]
  classChangeLogs  ClassChangeLog[]
  characterWeapons CharacterWeapon[]
  gameSessions     GameSession[]
}

enum AttributeType {
  STRENGTH
  ENDURANCE
  AGILITY
  DEXTERITY
  VITALITY
}

model Attribute {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        AttributeType
  xp          Int           @default(0)
  level       Int           @default(1)
  updatedAt   DateTime      @updatedAt

  @@unique([characterId, type])
}

enum SessionType {
  WEIGHTS
  CARDIO
  CALISTHENICS
  SPORT
}

enum RoutineType {
  WEIDER
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  OTHER
}

model WorkoutSession {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SessionType
  routineType RoutineType?
  date        DateTime     @default(now())
  durationMin Int
  notes       String?
  xpGained    Int?
  createdAt   DateTime     @default(now())

  routineId        String?
  routine          Routine? @relation(fields: [routineId], references: [id])

  weightSets       WeightSet[]
  calisthenicsSets CalisthenicsSet[]
  cardioDetail     CardioDetail?
  sportDetail      SportDetail?

  @@index([userId, date])
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  FULL_BODY
  OTHER
}

model Exercise {
  id          String       @id @default(cuid())
  name        String       @unique
  muscleGroup MuscleGroup?

  weightSets       WeightSet[]
  routineExercises RoutineExercise[]
}

model WeightSet {
  id          String         @id @default(cuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber   Int
  reps        Int
  weightKg    Float
  restSeconds Int?
  rir         Int? // Reps in Reserve: 0-3
  note        String?

  @@index([exerciseId])
}

model CalisthenicsMovement {
  id          String       @id @default(cuid())
  name        String       @unique
  muscleGroup MuscleGroup?

  calisthenicsSets CalisthenicsSet[]
  routineExercises RoutineExercise[]
}

model CalisthenicsSet {
  id          String               @id @default(cuid())
  sessionId   String
  session     WorkoutSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movementId  String
  movement    CalisthenicsMovement @relation(fields: [movementId], references: [id])
  setNumber   Int
  reps        Int
  progression String
  restSeconds Int?
  rir         Int? // Reps in Reserve: 0-3
  note        String?

  @@index([movementId])
}

enum CardioType {
  CONTINUOUS
  INTERVALS
  FARTLEK
}

model CardioDetail {
  id            String         @id @default(cuid())
  sessionId     String         @unique
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cardioType    CardioType     @default(CONTINUOUS)
  distanceKm    Float?
  avgPaceMinKm  Float?
  avgHeartRate  Int?

  intervals CardioInterval[]
}

enum IntervalType {
  WORK
  REST
}

model CardioInterval {
  id             String       @id @default(cuid())
  cardioDetailId String
  cardioDetail   CardioDetail @relation(fields: [cardioDetailId], references: [id], onDelete: Cascade)
  order          Int
  type           IntervalType
  distanceKm     Float?
  durationMin    Float?
  paceMinKm      Float?

  @@index([cardioDetailId, order])
}

model SportDetail {
  id                  String         @id @default(cuid())
  sessionId           String         @unique
  session             WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sportType           String
  perceivedIntensity  Int
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Mission {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  description String
  targetType  SessionType
  targetValue Int
  rewardXp    Int           @default(0)
  progress    Int           @default(0)
  status      MissionStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
}

model Achievement {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  description String
  unlockedAt  DateTime  @default(now())
}

model ClassChangeLog {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  fromClass   CharacterClass
  toClass     CharacterClass
  changedAt   DateTime       @default(now())
}

enum WeaponCategory {
  MELEE
  RANGED
  MAGIC
}

model Weapon {
  id            String         @id @default(cuid())
  name          String
  description   String
  category      WeaponCategory
  diceType      String
  baseDamage    Int
  requiredLevel Int

  characterWeapons CharacterWeapon[]
}

model CharacterWeapon {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  weaponId    String
  weapon      Weapon    @relation(fields: [weaponId], references: [id])

  xp            Int      @default(0)
  level         Int      @default(1)
  currentDamage Int
  equipped      Boolean  @default(false)
  unlockedAt    DateTime @default(now())

  gameSessions GameSession[]

  @@unique([characterId, weaponId])
  @@index([characterId, equipped])
}

model GameSession {
  id                String          @id @default(cuid())
  characterId       String
  character         Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterWeaponId String
  characterWeapon   CharacterWeapon @relation(fields: [characterWeaponId], references: [id])

  date        DateTime @default(now())
  durationMin Int?
  notes       String?
  kills       Int      @default(0)
  xpGained    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([characterId, date])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Routine {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  routineType RoutineType?
  createdAt   DateTime     @default(now())

  exercises RoutineExercise[]
  sessions  WorkoutSession[]
  days      RoutineDay[]

  @@index([userId])
}

model RoutineDay {
  id       String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  day      Weekday

  @@unique([routineId, day])
  @@index([routineId, day])
}

model RoutineExercise {
  id         String   @id @default(cuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  order      Int

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  movementId String?
  movement   CalisthenicsMovement? @relation(fields: [movementId], references: [id])

  targetSets    Int
  targetRepsMin Int
  targetRepsMax Int
  targetRir     Int?   // Reps in Reserve objetivo general: 0-3
  targetRirs    Int[]  @default([]) // RIR objetivo por serie

  @@index([routineId, order])
}
