datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())

  character       Character?
  workoutSessions WorkoutSession[]
}

enum CharacterClass {
  UNDEFINED
  WARRIOR
  EXPLORER
  MONK
  PALADIN
}

model Character {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  characterClass CharacterClass @default(UNDEFINED)

  level       Int @default(1)
  skillPoints Int @default(0)

  pendingClass CharacterClass?
  pendingSince DateTime?

  vitalityDecayAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attributes       Attribute[]
  missions         Mission[]
  achievements     Achievement[]
  classChangeLogs  ClassChangeLog[]
  characterWeapons CharacterWeapon[]
  gameSessions     GameSession[]
}

enum AttributeType {
  STRENGTH
  ENDURANCE
  AGILITY
  DEXTERITY
  VITALITY
}

model Attribute {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        AttributeType
  xp          Int           @default(0)
  level       Int           @default(1)
  updatedAt   DateTime      @updatedAt

  @@unique([characterId, type])
}

enum SessionType {
  WEIGHTS
  CARDIO
  CALISTHENICS
  SPORT
}

// Diario de entrenamiento: pertenece siempre al usuario, no requiere personaje.
// xpGained queda vacío si el usuario no tiene Character creado.
model WorkoutSession {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SessionType
  date        DateTime    @default(now())
  durationMin Int
  notes       String?
  xpGained    Int?
  createdAt   DateTime    @default(now())

  weightSets       WeightSet[]
  calisthenicsSets CalisthenicsSet[]
  cardioDetail     CardioDetail?
  sportDetail      SportDetail?

  @@index([userId, date])
}

// Catálogo reutilizable de ejercicios de pesas (para graficar evolución)
model Exercise {
  id   String @id @default(cuid())
  name String @unique

  weightSets WeightSet[]
}

model WeightSet {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float

  @@index([exerciseId])
}

// Catálogo reutilizable de movimientos de calistenia
model CalisthenicsMovement {
  id   String @id @default(cuid())
  name String @unique

  calisthenicsSets CalisthenicsSet[]
}

model CalisthenicsSet {
  id         String               @id @default(cuid())
  sessionId  String
  session    WorkoutSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movementId String
  movement   CalisthenicsMovement @relation(fields: [movementId], references: [id])
  setNumber  Int
  reps       Int
  progression String // ej. "estricta", "asistida"

  @@index([movementId])
}

// Bloque único de detalle de cardio por sesión (no series)
model CardioDetail {
  id            String         @id @default(cuid())
  sessionId     String         @unique
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  distanceKm    Float
  avgPaceMinKm  Float?
  avgHeartRate  Int?
}

// Bloque único de detalle de deporte por sesión
model SportDetail {
  id                  String         @id @default(cuid())
  sessionId           String         @unique
  session             WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sportType           String
  perceivedIntensity  Int // escala RPE 1-10
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Mission {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  description String
  targetType  SessionType
  targetValue Int
  rewardXp    Int           @default(0)
  progress    Int           @default(0)
  status      MissionStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
}

model Achievement {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  description String
  unlockedAt  DateTime  @default(now())
}

model ClassChangeLog {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  fromClass   CharacterClass
  toClass     CharacterClass
  changedAt   DateTime       @default(now())
}

enum WeaponCategory {
  MELEE
  RANGED
  MAGIC
}

model Weapon {
  id            String         @id @default(cuid())
  name          String
  description   String
  category      WeaponCategory
  diceType      String
  baseDamage    Int
  requiredLevel Int

  characterWeapons CharacterWeapon[]
}

model CharacterWeapon {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  weaponId    String
  weapon      Weapon    @relation(fields: [weaponId], references: [id])

  xp            Int      @default(0)
  level         Int      @default(1)
  currentDamage Int
  equipped      Boolean  @default(false)
  unlockedAt    DateTime @default(now())

  gameSessions GameSession[]

  @@unique([characterId, weaponId])
  @@index([characterId, equipped])
}

model GameSession {
  id                String          @id @default(cuid())
  characterId       String
  character         Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterWeaponId String
  characterWeapon   CharacterWeapon @relation(fields: [characterWeaponId], references: [id])

  date        DateTime @default(now())
  durationMin Int?
  notes       String?
  kills       Int      @default(0)
  xpGained    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([characterId, date])
}
